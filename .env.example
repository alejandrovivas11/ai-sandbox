# FastAPI Backend Configuration
# Database URL for the backend
# For development with SQLite (default):
DATABASE_URL=sqlite:///./data/staff.db

# For PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@postgres:5432/ai_sandbox

# Application settings
DEBUG=False
APP_TITLE=AI Sandbox
APP_VERSION=0.1.0

# Next.js Frontend Configuration
# API endpoint for frontend to connect to backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Next.js environment
NEXT_ENV=production

# Docker Compose Service Names
# These are used for internal service-to-service communication
BACKEND_HOST=backend
BACKEND_PORT=3001
FRONTEND_HOST=frontend
FRONTEND_PORT=3000

# Optional: CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000

# Optional: Logging Configuration
LOG_LEVEL=INFO

# Optional: Database settings
# For SQLite
DB_TYPE=sqlite
DB_PATH=/app/data/staff.db

# Optional: Application behavior
SEED_DATA=True
