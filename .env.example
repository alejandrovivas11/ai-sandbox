# ===========================================
# AI Sandbox Environment Configuration
# ===========================================
# Copy this file to .env and adjust values as needed
# Usage: cp .env.example .env

# ----- Database -----
# SQLite (default, for development)
DATABASE_URL=sqlite:///./data/staff.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@postgres:5432/ai_sandbox

# ----- FastAPI Backend -----
DEBUG=False
APP_TITLE=AI Sandbox
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ----- Docker Ports -----
# Change these if ports are already in use on your machine
BACKEND_PORT=3001
FRONTEND_PORT=3002

# ----- Next.js Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NODE_ENV=production

# ----- CORS (Optional) -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
