# FastAPI Backend Configuration
# Database URL for the backend
# For development with SQLite:
# DATABASE_URL=sqlite:///./data/staff.db

# For PostgreSQL with Docker Compose (recommended):
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_sandbox

# Application settings
DEBUG=False
APP_TITLE=AI Sandbox
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Next.js Frontend Configuration
# API endpoint for frontend to connect to backend
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=production

# Docker Service Configuration
# These are used for internal service-to-service communication
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
FRONTEND_HOST=frontend
FRONTEND_PORT=3000

# PostgreSQL Database Configuration
# Used by docker-compose for postgres service initialization
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sandbox
POSTGRES_PORT=5432

# Optional: CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://frontend:3000

# Optional: Application behavior
SEED_DATA=True

# Docker-specific configuration
# Logging format for Docker containers
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
